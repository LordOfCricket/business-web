# ==============================================================================
# @los/business-web - GCP Cloud Run Production Reference Configuration
# ==============================================================================
# This file illustrates the environment variables supplied to the Cloud Run
# service container when running in production on Google Cloud Platform.
#
# NOTE: In GitHub Actions (.github/workflows/deploy.yml), these are injected
# automatically via `--set-env-vars` and `--set-secrets`.
# ==============================================================================

# Private Cloud Run URL of the API gateway service
GATEWAY_URL=https://gateway-981116867868.asia-south2.run.app

# Audience used to fetch Cloud Run identity tokens from http://metadata.google.internal
GATEWAY_IAM_AUDIENCE=https://gateway-981116867868.asia-south2.run.app

# Public URL of this business-web service (or custom domain if mapped)
NEXT_PUBLIC_SITE_URL=https://business-web-981116867868.asia-south2.run.app

# Public URL of the customer portal
CUSTOMER_SITE_URL=https://customer-web-981116867868.asia-south2.run.app

# Public URL of the admin portal
ADMIN_SITE_URL=https://admin-web-981116867868.asia-south2.run.app

# Sports enabled in production
LAUNCHED_SPORTS=cricket,karate

# Shared proxy key (matched with gateway, stored in GCP Secret Manager as `frontend-proxy-key`)
FRONTEND_PROXY_KEY=production-frontend-proxy-key

# Server settings for Cloud Run container
PORT=3000
NODE_ENV=production
