# ==============================================================================
# @los/business-web Environment Variables
# ==============================================================================
# Local Development: Copy this file to `.env.local`.
# Production / GCP Cloud Run: Values are injected dynamically during deployment
# by the GitHub Actions workflow (.github/workflows/deploy.yml).
#
# IMPORTANT:
# - All variables here remain strictly server-side unless prefixed with NEXT_PUBLIC_.
# - Never commit actual secrets (.env or .env.local) to version control.
# ==============================================================================

# --- API Gateway Configuration ---
# The backend API Gateway that business-web communicates with via server-side BFF proxy.
# Local dev: http://localhost:8080 (via local-dev/newsports.ps1 up)
# GCP Cloud Run: URL of the deployed gateway service (e.g. https://gateway-981116867868.asia-south2.run.app)
GATEWAY_URL=http://localhost:8080

# When the gateway is deployed as a private Cloud Run service, set its URL as the IAM audience.
# The app queries GCP's metadata server to acquire a Google-signed ID token for authentication.
# Leave unset or empty for local development.
# GATEWAY_IAM_AUDIENCE=https://gateway-981116867868.asia-south2.run.app

# --- Site URL & Cross-Site Links ---
# Canonical URL of this business portal (used for CSRF validation on mutating BFF requests and SEO).
# Local dev: http://localhost:3001
# GCP Cloud Run: https://business-web-981116867868.asia-south2.run.app
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# The customer web application (used for "view in the shop" and public venue links).
# Local dev: http://localhost:3000
# GCP Cloud Run: https://customer-web-981116867868.asia-south2.run.app
CUSTOMER_SITE_URL=http://localhost:3000

# The admin portal (used for admin/staff links if needed).
# Local dev: http://localhost:3002
# GCP Cloud Run: https://admin-web-981116867868.asia-south2.run.app
ADMIN_SITE_URL=http://localhost:3002

# --- Platform Configuration ---
# Enabled sports on the platform, comma separated (cricket, karate, football, etc.).
LAUNCHED_SPORTS=cricket,karate

# Shared proxy authentication key between business-web and the API gateway.
# Allows the gateway to trust the client IP forwarded in X-Client-IP for rate limiting.
# Must match the gateway's FRONTEND_PROXY_KEY.
# Local dev: local-frontend-proxy-key
# GCP Cloud Run: retrieved from GCP Secret Manager (frontend-proxy-key) or GitHub secret.
FRONTEND_PROXY_KEY=local-frontend-proxy-key

# --- Server Runtime ---
# Port and environment used by Next.js standalone server (defaults to 3000 in Docker/Cloud Run).
PORT=3001
NODE_ENV=development
