    "@vitejs/plugin-react": "6.1.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.5",
    "jsdom": "30.1.0",
    "prettier": "3.9.8",
    "prettier-plugin-tailwindcss": "^0.7.0",
